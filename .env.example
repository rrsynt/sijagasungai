# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get from: https://aistudio.google.com/app/apikey (gunakan project BARU tanpa billing)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ─── AI FALLBACK PROVIDERS ────────────────────────────────────────────────────
# Sistem otomatis gilir semua key 1 provider, baru pindah ke provider berikutnya.
# Format: satu key → GROQ_API_KEY="gsk_xxx"
#         banyak key → GROQ_API_KEYS="gsk_aaa,gsk_bbb,gsk_ccc"
# Provider aktif secara otomatis jika key tersedia. Urutan: Groq → OpenRouter → Hyperbolic
# Tidak perlu memilih — semua provider dengan key akan digunakan bergiliran.

# GROQ: Gratis 14.400 req/hari per account, super cepat, no credit card required
# Buat banyak akun Groq untuk mendapat lebih banyak quota gratis
# Get from: https://console.groq.com/keys
GROQ_API_KEYS=""

# OPENROUTER: Akses 100+ model via 1 key, ada model gratis (e.g. gemini-flash-exp:free)
# Get from: https://openrouter.ai/settings/keys
OPENROUTER_API_KEYS=""

# HYPERBOLIC: Credit gratis $10 saat sign up, vision model Qwen2-VL-72B sangat akurat
# Get from: https://app.hyperbolic.xyz/settings
HYPERBOLIC_API_KEYS=""

# APP_URL: The public URL of this app (Cloud Run URL after first deploy).
# Used for absolute path metadata and OG images.
APP_URL="https://sijaga-sungai-701628588260.asia-southeast1.run.app"

# GOOGLE MAPS PLATFORM
# Enable: Maps JavaScript API
# Get from: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_KEY"

# FIREBASE ADMIN SDK CREDENTIALS
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID="my-firebase-project-id"
FIREBASE_CLIENT_EMAIL="my-firebase-client-email@project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIB...-----END PRIVATE KEY-----\n"

# SEED_SECRET: Protects POST /api/seed from unauthorized use in production.
# Set to any random string, e.g. openssl rand -hex 32
SEED_SECRET="change_this_to_random_string"
