rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reports: anyone can read, only server (Admin SDK) can write
    match /reports/{reportId} {
      allow read: if true;
      // Writes come from Firebase Admin SDK (server-side) — no client write allowed
      allow write: if false;
    }

    // All other collections: deny by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
